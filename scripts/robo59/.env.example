# Configuração do robô do 59. Copie para `.env` na mesma pasta e preencha.
# O arquivo `.env` NÃO vai para o git — ele tem senha.

# ── Onde o ERP deixa o arquivo ───────────────────────────────────────────────
# Caminho completo, com o nome do arquivo. Aspas se houver espaço no caminho.
ROBO_ARQUIVO="C:\Relatorios\rel_59_202609.csv"

# ── Qual empresa ─────────────────────────────────────────────────────────────
# O uuid da empresa. Está na URL do Painel Diretoria, ou peça a quem instalou.
ROBO_EMPRESA_ID=

# ── O sistema ────────────────────────────────────────────────────────────────
# As duas saem do painel do Supabase, em Settings › API. A chave anônima é a
# mesma que o site usa — ela não dá acesso a nada sozinha.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── A conta do robô ──────────────────────────────────────────────────────────
# Conta criada só para isto, SEM ser super_admin. Ela tem uma permissão só:
# `mestre_importar_automatico`. Quem pegar esta senha consegue importar o
# relatório 59 — e nada mais.
ROBO_EMAIL=
ROBO_SENHA=

# ── Opcional ─────────────────────────────────────────────────────────────────
# Quantas horas o arquivo pode ficar sem ser reescrito antes de o robô avisar
# que o ERP pode ter parado. Padrão: 3.
# ROBO_HORAS_ATE_SUSPEITAR=3
