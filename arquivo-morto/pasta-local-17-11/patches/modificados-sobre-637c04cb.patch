+    expect(p.temasVistos).toEqual(['arcade']);
+  });
+
+  it('campo estragado vira lista vazia, e item que não é texto é descartado', () => {
+    expect(normalizarProgresso({ museuVisto: 'pet' }).museuVisto).toEqual([]);
+    expect(normalizarProgresso({ museuVisto: null }).museuVisto).toEqual([]);
+    expect(normalizarProgresso({ museuVisto: { pet: true } }).museuVisto).toEqual([]);
+    expect(normalizarProgresso({ museuVisto: ['pet', 7, null, 'sirene'] }).museuVisto)
+      .toEqual(['pet', 'sirene']);
+  });
+
