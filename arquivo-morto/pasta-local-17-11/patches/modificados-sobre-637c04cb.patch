+}
+
+.creators-lab__relogio {
+  padding: 0 .5rem;
+  font-variant-numeric: tabular-nums;
+  white-space: nowrap;
+}
+
+/* hud — faixa fina no topo, tudo em caixa alta, a janela ativa sublinhada. */
+.creators-lab[data-barra="hud"] .creators-lab__barra-tarefas {
+  border-bottom: 1px solid color-mix(in srgb, var(--creator-primary) 55%, transparent);
+  letter-spacing: .14em;
+  text-transform: uppercase;
+  font-size: .64rem;
+}
+
+.creators-lab[data-barra="hud"] .creators-lab__barra-botao--iniciar {
+  background: var(--creator-primary);
+  color: var(--creator-bg);
+  font-weight: 700;
+  clip-path: polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 0 100%);
+  padding-right: .9rem;
+}
+
+.creators-lab[data-barra="hud"] .creators-lab__barra-botao[data-ativo="true"] {
+  color: var(--creator-primary);
+  border-bottom-color: var(--creator-primary);
+}
+
+.creators-lab[data-barra="hud"] .creators-lab__barra-janelas .creators-lab__barra-botao:hover,
+.creators-lab[data-barra="hud"] .creators-lab__barra-bandeja .creators-lab__barra-botao:hover { color: var(--creator-primary); }
+.creators-lab[data-barra="hud"] .creators-lab__relogio { color: var(--creator-primary); }
+
+/* painel — o painel de controle do gabinete: alto, com botões de bloco. */
+.creators-lab[data-barra="painel"] .creators-lab__barra-tarefas {
+  border-top: 3px solid var(--creator-primary);
+  font-family: var(--creator-font-display);
+  font-size: .8rem;
+  letter-spacing: .06em;
+  text-transform: uppercase;
+  box-shadow: 0 -6px 0 rgba(0,0,0,.35);
+}
+
+.creators-lab[data-barra="painel"] .creators-lab__barra-botao {
+  border: 2px solid var(--creator-border);
+  background: var(--creator-bg);
+  box-shadow: 3px 3px 0 rgba(0,0,0,.6);
+}
+
+.creators-lab[data-barra="painel"] .creators-lab__barra-botao--iniciar {
+  background: var(--creator-accent);
+  color: #000;
+  border-color: #000;
+  border-radius: 999px;
+  padding: 0 1rem;
+}
+
+.creators-lab[data-barra="painel"] .creators-lab__barra-botao[data-ativo="true"] {
+  background: var(--creator-primary);
+  color: var(--creator-title-text);
+  border-color: #000;
+}
+
+.creators-lab[data-barra="painel"] .creators-lab__barra-botao:active { transform: translate(2px, 2px); box-shadow: none; }
+.creators-lab[data-barra="painel"] .creators-lab__relogio { color: var(--creator-accent); font-family: var(--creator-font-mono); }
+
+/* iniciar — a barra cinza de escritório, com o botão Iniciar em relevo. */
+.creators-lab[data-barra="iniciar"] .creators-lab__barra-tarefas {
+  border-top: 2px solid var(--creator-relevo-claro);
+  font-family: var(--creator-font-body);
+  font-size: .74rem;
+}
+
+.creators-lab[data-barra="iniciar"] .creators-lab__barra-botao {
+  border: 2px solid;
+  border-color:
+    var(--creator-relevo-claro) var(--creator-relevo-escuro)
+    var(--creator-relevo-escuro) var(--creator-relevo-claro);
+}
+
+.creators-lab[data-barra="iniciar"] .creators-lab__barra-botao--iniciar { font-weight: 700; }
+
+.creators-lab[data-barra="iniciar"] .creators-lab__barra-botao[data-ativo="true"],
+.creators-lab[data-barra="iniciar"] .creators-lab__barra-botao:active {
+  border-color:
+    var(--creator-relevo-escuro) var(--creator-relevo-claro)
+    var(--creator-relevo-claro) var(--creator-relevo-escuro);
+  background: var(--creator-surface);
+}
+
+.creators-lab[data-barra="iniciar"] .creators-lab__relogio {
+  border: 1px solid;
+  border-color:
+    var(--creator-relevo-escuro) var(--creator-relevo-claro)
+    var(--creator-relevo-claro) var(--creator-relevo-escuro);
+  height: calc(var(--creator-bar-h) - 10px);
+  display: flex;
+  align-items: center;
+}
+
+/* ── Menu de programas ── */
+
+.creators-lab__menu {
+  position: absolute;
+  left: .5rem;
+  z-index: 45;
+  width: min(17rem, calc(100vw - 1rem));
+  max-height: calc(100% - var(--creator-bar-h) - 1rem);
+  overflow-y: auto;
+  padding: .3rem;
+  background: var(--creator-bar-bg);
+  color: var(--creator-bar-text);
+  border: var(--creator-border-w) solid var(--creator-border);
+  box-shadow: var(--creator-shadow);
+  animation: creators-janela-surge var(--creator-duracao) var(--creator-easing) both;
+}
+
+.creators-lab[data-barra-posicao="topo"] .creators-lab__menu { top: calc(var(--creator-bar-h) + 4px); }
+.creators-lab[data-barra-posicao="base"] .creators-lab__menu { bottom: calc(var(--creator-bar-h) + 4px); }
+
+.creators-lab[data-forma="chanfro"] .creators-lab__menu {
+  border-color: color-mix(in srgb, var(--creator-primary) 55%, var(--creator-border));
+  clip-path: polygon(0 0, calc(100% - 14px) 0, 100% 14px, 100% 100%, 0 100%);
+}
+
+.creators-lab[data-forma="relevo"] .creators-lab__menu {
+  border-style: solid;
+  border-color:
+    var(--creator-relevo-claro) var(--creator-relevo-escuro)
+    var(--creator-relevo-escuro) var(--creator-relevo-claro);
+}
+
+.creators-lab__menu-item {
+  width: 100%;
+  display: flex;
+  align-items: center;
+  gap: .6rem;
+  padding: .45rem .6rem;
+  font-family: var(--creator-font-body);
+  font-size: .8rem;
+  text-align: left;
+  color: inherit;
+  background: transparent;
+  border: 0;
+}
+
+.creators-lab__menu-item svg { width: 18px; height: 18px; flex: none; color: var(--creator-primary); }
+
+.creators-lab__menu-item:hover,
+.creators-lab__menu-item:focus-visible {
+  background: var(--creator-primary);
+  color: var(--creator-bg);
+  outline: 0;
+}
+
+.creators-lab__menu-item:hover svg,
+.creators-lab__menu-item:focus-visible svg { color: inherit; }
+
+.creators-lab__menu-separador {
+  height: 1px;
+  margin: .3rem .2rem;
+  background: var(--creator-border);
+}
+
+/* ── Avisos (conquista, oferta de movimento) ── */
+
+.creators-lab__aviso {
+  position: absolute;
+  right: 1rem;
+  z-index: 60;
+  width: min(22rem, calc(100vw - 2rem));
+  background: var(--creator-bg);
+}
+
+.creators-lab[data-barra-posicao="topo"] .creators-lab__aviso { top: calc(var(--creator-bar-h) + 1rem); }
+.creators-lab[data-barra-posicao="base"] .creators-lab__aviso { bottom: calc(var(--creator-bar-h) + 1rem); }
+
+/* ══ Celular ══════════════════════════════════════════════════════════════
+ *
+ * Sem arrastar. A área de trabalho é uma grade de ícones e cada programa abre
+ * em tela cheia, com um botão de voltar no lugar dos botões de janela. Quem
+ * liga este modo é `data-celular`, escrito pela área de trabalho — a mesma
+ * medida que decide o comportamento decide o desenho, sem media query para as
+ * duas discordarem.
+ */
+.creators-lab__mesa[data-celular="true"] .creators-lab__icones {
+  grid-auto-flow: row;
+  grid-template-rows: none;
+  grid-template-columns: repeat(auto-fill, minmax(5.2rem, 1fr));
+  grid-auto-rows: min-content;
+  justify-content: stretch;
+  gap: .9rem .25rem;
+  overflow-y: auto;
+  padding: 1.1rem .75rem;
+}
+
+.creators-lab__mesa[data-celular="true"] .creators-lab__janela {
+  inset: 0;
+  transform: none !important;
+  width: auto !important;
+  height: auto !important;
+  z-index: 30 !important;
+}
+
+/* A barra de tarefas continua à vista: o botão de movimento mora nela. */
+.creators-lab[data-barra-posicao="topo"] .creators-lab__mesa[data-celular="true"] .creators-lab__janela { top: var(--creator-bar-h); }
+.creators-lab[data-barra-posicao="base"] .creators-lab__mesa[data-celular="true"] .creators-lab__janela { bottom: var(--creator-bar-h); }
+
+.creators-lab__mesa[data-celular="true"] .creators-lab__janela-quadro {
+  clip-path: none;
+  border-width: 0;
+  box-shadow: none;
+  padding: 0;
+}
+
+.creators-lab__mesa[data-celular="true"] .creators-lab__janela-titulo {
+  height: 44px;
+  padding: 0 .5rem;
+  touch-action: auto;
+}
+
+.creators-lab__mesa[data-celular="true"] .creators-lab__janela-rolagem { padding: 1rem .9rem 2rem; }
+
+.creators-lab__janela-voltar {
+  flex: none;
+  height: 32px;
+  padding: 0 .7rem;
+  font: inherit;
+  color: inherit;
+  background: transparent;
+  border: 1px solid currentColor;
+}
+
+.creators-lab__mesa[data-celular="true"] .creators-lab__barra-janelas { visibility: hidden; }
+.creators-lab__mesa[data-celular="true"] .creators-lab__papel-marca { display: none; }
+
+/* ══ Inicialização ════════════════════════════════════════════════════════
+ *
+ * A máquina ligando. O fundo é PRETO do primeiro ao último quadro: o
+ * escurecimento do Gestão termina em preto e a emenda depende disto. As cores
+ * de dentro vêm do tema já escolhido (ou do padrão, antes da escolha).
+ */
+.creators-lab__intro {
+  position: absolute;
+  inset: 0;
+  z-index: 100;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 1.25rem;
+  padding: 1.5rem;
+  background: #000;
+  color: #E6E6E6;
+  overflow-y: auto;
+  cursor: default;
+}
+
+.creators-lab__intro-sai { animation: creators-intro-sai .45s ease forwards; }
+
+@keyframes creators-intro-sai {
+  to { opacity: 0; }
+}
+
+.creators-lab__intro-pular {
+  position: absolute;
+  left: 0; right: 0; bottom: 1.1rem;
+  text-align: center;
+  font-family: var(--creator-font-mono);
+  font-size: .62rem;
+  letter-spacing: .2em;
+  color: rgba(255,255,255,.32);
+  pointer-events: none;
+}
+
+.creators-lab__intro-autoteste {
+  width: min(34rem, 100%);
+  font-family: var(--creator-font-mono);
+  font-size: clamp(.66rem, 2.6vw, .82rem);
+  line-height: 1.7;
+  white-space: pre-wrap;
+}
+
+.creators-lab__intro-autoteste p { margin: 0; animation: creators-linha .18s ease both; }
+
+@keyframes creators-linha {
+  from { opacity: 0; transform: translateX(-8px); }
+  to   { opacity: 1; transform: none; }
+}
+
+.creators-lab__intro-cursor {
+  display: inline-block;
+  width: .6em; height: 1em;
+  margin-left: .15em;
+  vertical-align: text-bottom;
+  background: currentColor;
+  animation: creators-piscar 1s steps(1) infinite;
+}
+
+.creators-lab__intro-marca {
+  font-family: var(--creator-font-display);
+  font-size: clamp(2rem, 9vw, 4.5rem);
+  font-weight: 700;
+  line-height: 1;
+  color: var(--creator-primary);
+  text-align: center;
+}
+
+.creators-lab__intro-lema {
+  font-family: var(--creator-font-mono);
+  font-size: .7rem;
+  letter-spacing: .26em;
+  text-transform: uppercase;
+  color: rgba(255,255,255,.55);
+  text-align: center;
+}
+
+/* varredura — a marca entra abrindo o espaçamento, com uma linha que desce. */
+.creators-lab__intro[data-estilo="varredura"] .creators-lab__intro-marca {
+  text-transform: uppercase;
+  text-shadow: 0 0 34px var(--creator-glow);
+  animation: creators-marca-varre 1.1s cubic-bezier(.16,1,.3,1) both;
+}
+
+@keyframes creators-marca-varre {
+  from { opacity: 0; letter-spacing: -.04em; }
+  to   { opacity: 1; letter-spacing: .16em; }
+}
+
+.creators-lab__intro[data-estilo="varredura"][data-agitado="true"]::after {
+  content: '';
+  position: absolute;
+  left: 0; right: 0;
+  height: 2px;
+  background: var(--creator-primary);
+  box-shadow: 0 0 18px var(--creator-primary);
+  animation: creators-varredura 1.2s linear both;
+  pointer-events: none;
+}
+
+@keyframes creators-varredura {
+  from { top: 0; opacity: .9; }
+  to   { top: 100%; opacity: 0; }
+}
+
+/* blocos — a marca cai em degraus e bate, com sombra dura. */
+.creators-lab__intro[data-estilo="blocos"] .creators-lab__intro-marca {
+  text-transform: uppercase;
+  letter-spacing: .05em;
+  text-shadow: 5px 5px 0 var(--creator-secondary), 10px 10px 0 rgba(0,0,0,.8);
+  animation: creators-marca-cai .7s steps(6) both;
+}
+
+@keyframes creators-marca-cai {
+  from { transform: translateY(-60vh); }
+  to   { transform: none; }
+}
+
+.creators-lab__intro[data-estilo="blocos"] .creators-lab__intro-lema {
+  color: var(--creator-accent);
+  animation: creators-piscar 1.1s steps(1) infinite;
+}
+
+/* progresso — a marca aparece parada, e uma barra enche embaixo. */
+.creators-lab__intro[data-estilo="progresso"] .creators-lab__intro-marca {
+  color: #fff;
+  font-size: clamp(1.8rem, 7vw, 3.2rem);
+  letter-spacing: 0;
+}
+
+.creators-lab__intro-progresso {
+  width: min(16rem, 70vw);
+  height: 14px;
+  padding: 2px;
+  border: 1px solid rgba(255,255,255,.5);
+}
+
+.creators-lab__intro-progresso > span {
+  display: block;
+  height: 100%;
+  background: repeating-linear-gradient(90deg, var(--creator-wallpaper) 0 10px, transparent 10px 13px);
+  animation: creators-progresso var(--creator-progresso-ms, 1200ms) steps(12) both;
+}
+
+@keyframes creators-progresso {
+  from { width: 0; }
+  to   { width: 100%; }
+}
+
+/* A barra de progresso é do estilo "progresso"; os outros dois não mostram. */
+.creators-lab__intro:not([data-estilo="progresso"]) .creators-lab__intro-progresso { display: none; }
+
+/* O botão sobre o preto da inicialização: texto claro, menos no relevo, que
+   tem fundo próprio. */
+.creators-lab__intro .creators-lab__btn { color: #fff; }
+.creators-lab[data-forma="relevo"] .creators-lab__intro .creators-lab__btn { color: var(--creator-text); }
+
+/* ── Tela de entrada ── */
+
+.creators-lab__entrada {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: .9rem;
+  text-align: center;
+  animation: creators-janela-surge .5s ease both;
+}
+
+.creators-lab__entrada-foto {
+  width: 96px;
+  height: 96px;
+  display: grid;
+  place-items: center;
+  object-fit: cover;
+  font-family: var(--creator-font-display);
+  font-size: 2rem;
+  color: var(--creator-primary);
+  background: #0c0c0c;
+  border: 2px solid var(--creator-primary);
+}
+
+.creators-lab__entrada-nome {
+  font-family: var(--creator-font-display);
+  font-size: 1.35rem;
+  color: #fff;
+}
+
+/* ── Escolha de aparência ── */
+
+.creators-lab__aparencias {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
+  gap: 1rem;
+  width: min(60rem, 100%);
+}
+
+.creators-lab__aparencia {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  gap: .6rem;
+  padding: 0;
+  text-align: left;
+  background: transparent;
+  border: 0;
+}
+
+.creators-lab__aparencia-amostra {
+  position: relative;
+  height: 8.5rem;
+  overflow: hidden;
+}
+
+.creators-lab__aparencia-janela {
+  position: absolute;
+  left: 14%;
+  top: 16%;
+  width: 62%;
+  height: 58%;
+  display: flex;
+  flex-direction: column;
+}
+
+.creators-lab__aparencia-barra { position: absolute; left: 0; right: 0; height: 12px; }
+
+.creators-lab__aparencia[aria-pressed="true"] .creators-lab__aparencia-amostra,
+.creators-lab__aparencia:hover .creators-lab__aparencia-amostra,
+.creators-lab__aparencia:focus-visible .creators-lab__aparencia-amostra {
+  outline: 3px solid var(--creator-aparencia-contorno, #fff);
+  outline-offset: 3px;
+}
+
+.creators-lab__aparencia:focus-visible { outline: 0; }
+
+/* ══ Museu ════════════════════════════════════════════════════════════════
+ *
+ * O mapa das salas de um lado, a sala aberta do outro. A divisão em duas
+ * colunas depende da largura DA JANELA, não da tela: por isso é uma consulta
+ * de contêiner (`@container`), e não `@media`. Uma janela estreita num monitor
+ * largo empilha as duas partes, igual ao celular.
+ */
+.creators-lab__museu {
+  container-type: inline-size;
+  container-name: creators-museu;
+}
+
+.creators-lab__museu-mapa {
+  margin-bottom: 1.25rem;
+  padding-bottom: 1rem;
+  border-bottom: 1px solid var(--creator-border);
+}
+
+.creators-lab__museu-epoca { margin-top: .9rem; }
+
+.creators-lab__museu-epoca h3 {
+  font-size: .82rem;
+  font-weight: 700;
+}
+
+.creators-lab__museu-epoca p { font-size: .6rem; }
+
+.creators-lab__museu-epoca ul {
+  list-style: none;
+  margin: .35rem 0 0;
+  padding: 0;
+  display: flex;
+  flex-wrap: wrap;
+  gap: .3rem;
+}
+
+.creators-lab__museu-sala {
+  display: inline-flex;
+  align-items: baseline;
+  gap: .4rem;
+  padding: .3rem .55rem;
+  font-family: var(--creator-font-body);
+  font-size: .76rem;
+  text-align: left;
+  color: var(--creator-text);
+  background: transparent;
+  border: 1px solid var(--creator-border);
+}
+
+.creators-lab__museu-sala > span:first-child {
+  font-size: .6rem;
+  color: var(--creator-primary);
+}
+
+.creators-lab__museu-sala:hover { border-color: var(--creator-primary); }
+
+.creators-lab__museu-sala[aria-current="true"] {
+  background: var(--creator-primary);
+  border-color: var(--creator-primary);
+  color: var(--creator-bg);
+}
+
+.creators-lab__museu-sala[aria-current="true"] > span:first-child { color: inherit; }
+
+/* A grade fica num elemento de DENTRO: um contêiner não consegue aplicar a
+   própria consulta a si mesmo, só aos descendentes. */
+@container creators-museu (min-width: 44rem) {
+  .creators-lab__museu-grade {
+    display: grid;
+    grid-template-columns: 14.5rem minmax(0, 1fr);
+    gap: 1.5rem;
+    align-items: start;
+  }
+
+  .creators-lab__museu-mapa {
+    margin-bottom: 0;
+    padding: 0 1rem 0 0;
+    border-bottom: 0;
+    border-right: 1px solid var(--creator-border);
+  }
+
+  .creators-lab__museu-epoca ul { flex-direction: column; flex-wrap: nowrap; }
+  .creators-lab__museu-sala { width: 100%; }
+}
+
+/* ── A sala ── */
+
+.creators-lab__etiqueta {
+  padding: .1rem .4rem;
+  font-size: .6rem;
+  letter-spacing: .08em;
+  text-transform: uppercase;
+  border: 1px solid currentColor;
+}
+
+/* A vitrine: onde a arte da sala fica exposta. Fundo escuro nos três temas —
+   é o fundo em que os sprites da época foram desenhados. */
+.creators-lab__vitrine {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: flex-end;
+  justify-content: center;
+  gap: 1.1rem;
+  min-height: 9.5rem;
+  padding: 1.1rem;
+  background:
+    radial-gradient(ellipse 80% 90% at 50% 100%, rgba(255,255,255,.07), transparent 70%),
+    #14121A;
+  border: var(--creator-border-w) solid var(--creator-border);
+  overflow: hidden;
+}
+
+.creators-lab__placa {
+  width: 7rem;
+  height: 7rem;
+  display: block;
+  filter: drop-shadow(0 6px 0 rgba(0,0,0,.45));
+}
+
+.creators-lab__medalha {
+  margin: 0;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  color: #D8D4E6;
+  font-family: var(--creator-font-mono);
+  font-size: .58rem;
+  text-align: center;
+}
+
+.creators-lab__medalha-fita {
+  width: 12px;
+  height: 20px;
+  background: linear-gradient(90deg, #B4232C 0 50%, #7A141B 50% 100%);
+}
+
+.creators-lab__medalha-disco {
+  width: 56px;
+  height: 56px;
+  margin-bottom: .35rem;
+  display: grid;
+  place-items: center;
+  border-radius: 50%;
+  background: radial-gradient(circle at 35% 30%, #FFE9A8, #C89A2B 60%, #7A5A12);
+  box-shadow: inset 0 0 0 3px rgba(0,0,0,.25), 0 3px 0 rgba(0,0,0,.4);
+  overflow: hidden;
+}
+
+.creators-lab__marcos {
+  list-style: none;
+  margin: 0;
+  padding: 0 0 0 .9rem;
+  border-left: 2px solid var(--creator-border);
+  display: grid;
+  gap: .45rem;
+  font-size: .8rem;
+}
+
+.creators-lab__marcos li {
+  display: flex;
+  flex-wrap: wrap;
+  gap: .15rem .6rem;
+  align-items: baseline;
+}
+
+.creators-lab__marcos li > span:first-child { font-size: .72rem; }
+
+/* ── As peças ── */
+
+/* Caça: uma tela de mentira, com linhas de mentira, para o zumbi se esconder. */
+.creators-lab__tela-ficticia {
+  position: relative;
+  height: 11rem;
+  padding: .9rem;
+  display: grid;
+  align-content: start;
+  gap: .55rem;
+  background: var(--creator-surface);
+  border: 1px solid var(--creator-border);
+  overflow: hidden;
+}
+
+.creators-lab__tela-ficticia-linha {
+  display: block;
+  height: .6rem;
+  background: color-mix(in srgb, var(--creator-text-soft) 28%, transparent);
+}
+
+.creators-lab__zumbi-escondido {
+  position: absolute;
+  padding: 0;
+  line-height: 0;
+  background: transparent;
+  border: 0;
+}
+
+/* Pesquisa */
+.creators-lab__carinha {
+  flex: 1;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: .25rem;
+  padding: .5rem .3rem;
+  font-family: var(--creator-font-body);
+  font-size: .68rem;
+  color: var(--creator-text);
+  background: transparent;
+  border: 1px solid var(--creator-border);
+}
+
+.creators-lab__carinha > span { font-size: 1.5rem; line-height: 1; }
+.creators-lab__carinha:hover { border-color: var(--creator-primary); }
+
+.creators-lab__carinha[aria-pressed="true"] {
+  border-color: var(--creator-primary);
+  background: color-mix(in srgb, var(--creator-primary) 18%, transparent);
+}
+
+/* Corrida */
+.creators-lab__pista {
+  display: grid;
+  gap: .3rem;
+  padding: .5rem;
+  background: var(--creator-surface);
+  border: 1px solid var(--creator-border);
+}
+
+.creators-lab__raia {
+  position: relative;
+  height: 48px;
+  border-bottom: 1px dashed color-mix(in srgb, var(--creator-text-soft) 45%, transparent);
+  /* A linha de chegada. */
+  border-right: 4px double var(--creator-primary);
+}
+
+.creators-lab__raia:last-child { border-bottom: 0; }
+
+.creators-lab__raia-nome {
+  position: absolute;
+  right: .6rem;
+  top: 50%;
+  transform: translateY(-50%);
+  font-family: var(--creator-font-mono);
+  font-size: .6rem;
+  color: var(--creator-text-soft);
+}
+
+.creators-lab__corredor {
+  position: absolute;
+  top: 2px;
+  transition-property: left;
+  transition-timing-function: cubic-bezier(.3, .1, .4, 1);
+}
+
+/* Sirene */
+.creators-lab__lampada {
+  height: 5.5rem;
+  background: #17171B;
+  border: 1px solid var(--creator-border);
+}
+
+.creators-lab__lampada[data-acesa="true"] {
+  background: var(--creator-lampada);
+  box-shadow: 0 0 34px color-mix(in srgb, var(--creator-lampada) 60%, transparent);
+}
+
+/* 0,8 s por ciclo: devagar de propósito — ver `museu/pecas/Sirene.tsx`. */
+.creators-lab__lampada[data-pisca="true"] { animation: creators-lampada-pisca .8s ease-in-out infinite alternate; }
+
+@keyframes creators-lampada-pisca {
+  from { opacity: 1; }
+  to   { opacity: .35; }
+}
+
+/* Modo TV */
+.creators-lab__mesa-tv {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: .6rem;
+}
+
+.creators-lab__telinha {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: .2rem;
+  min-height: 7rem;
+  padding: .6rem;
+  color: #E9EEF7;
+  background: #101A2C;
+  border: 3px solid #2B2B2B;
+  text-align: center;
+}
+
+.creators-lab__telinha[data-no-ar="true"] { border-color: #D4242B; }
+
+.creators-lab__telinha-rotulo {
+  font-family: var(--creator-font-mono);
+  font-size: .56rem;
+  letter-spacing: .18em;
+  text-transform: uppercase;
+  opacity: .7;
+}
+
+.creators-lab__telinha[data-no-ar="true"] .creators-lab__telinha-rotulo { color: #FF6B70; opacity: 1; }
+
+.creators-lab__telinha-grande {
+  font-family: var(--creator-font-display);
+  font-size: 1.7rem;
+  font-weight: 700;
+  line-height: 1.1;
+}
+
+.creators-lab__telinha-pequeno { font-size: .6rem; opacity: .7; }
+
+/* ── Movimento reduzido ───────────────────────────────────────────────── */
+/*
+ * Ligado pelo atributo, NÃO por media query — ver a explicação no topo do
+ * arquivo. Quem quiser menos movimento aperta o botão na barra do Lab; a
+ * preferência do sistema apenas sugere, e a sugestão aparece uma vez.
+ *
+ * Não é só "animação mais curta": some com o que pisca e com o que se desloca
+ * muito, que é o que atrapalha pessoas fotossensíveis.
+ */
+.creators-lab[data-movimento="reduzido"] *,
+.creators-lab[data-movimento="reduzido"]::before,
+.creators-lab[data-movimento="reduzido"]::after {
+  animation-duration: .01ms !important;
+  animation-iteration-count: 1 !important;
+  transition-duration: .01ms !important;
+}
+
+.creators-lab[data-movimento="reduzido"] .creators-lab__papel-camada--b,
+.creators-lab[data-movimento="reduzido"] .creators-lab__papel-camada--c { opacity: .18; }
+.creators-lab[data-movimento="reduzido"] .creators-lab__papel-camada--a { animation: none; }
+.creators-lab[data-movimento="reduzido"] .creators-lab__falha::before,
+.creators-lab[data-movimento="reduzido"] .creators-lab__falha::after { display: none; }
+.creators-lab[data-movimento="reduzido"] .creators-lab__piscar  { animation: none; opacity: 1; }
+
+.creators-lab[data-movimento="reduzido"] .creators-lab__intro-cursor { animation: none; }
+.creators-lab[data-movimento="reduzido"] .creators-lab__intro::after { display: none; }
+
+.creators-lab[data-movimento="reduzido"] .creators-lab__lampada { animation: none; }
