+    expect(mesclarProgresso(a, b).museuVisto.sort()).toEqual(['modo-tv', 'pet', 'sirene']);
+  });
+
+  /** Progresso nunca retrocede: o lado que sabe menos não apaga o que sabe mais. */
+  it('visita não se desfaz, em nenhuma ordem', () => {
+    const visitou = com({ museuVisto: ['pet', 'caca'] });
+    expect(mesclarProgresso(visitou, PROGRESSO_VAZIO).museuVisto).toEqual(['pet', 'caca']);
